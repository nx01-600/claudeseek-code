# Shell scripts must stay LF even on Windows: with CRLF the shebang breaks
# when cloned on macOS or Linux ("bad interpreter").
* text=auto

*.sh   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Bash shims, no extension
gateway/bin/deepseek      text eol=lf
gateway/deepseek-session  text eol=lf
gateway/dsk               text eol=lf

# These are native to Windows
*.cmd text eol=crlf
*.ps1 text eol=crlf
